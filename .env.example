# Base de données (dev : docker compose up -d → Postgres sur 5433)
DATABASE_URL="postgresql://pogohub:pogohub@localhost:5433/pogohub?schema=public"

# Secret de session (32+ caractères) : openssl rand -base64 32
AUTH_SECRET="change-me-please-change-me-please-32"

# Protège /api/cron/* (Vercel Cron envoie ce jeton)
CRON_SECRET="change-me-cron"

# Adaptateur gobattlelog : désactivé par défaut (site derrière login Firebase).
# Renseigner son propre cookie de session pour l'activer.
GOBATTLELOG_ENABLED="false"
GOBATTLELOG_COOKIE=""

# URL publique (liens de partage, images OG)
NEXT_PUBLIC_APP_URL="http://localhost:3002"
